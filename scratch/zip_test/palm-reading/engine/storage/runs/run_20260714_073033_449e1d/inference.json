                                "advice": "\u0910\u0938\u0940 \u092d\u0942\u092e\u093f\u0915\u093e\u0913\u0902 \u0915\u0940 \u0924\u0932\u093e\u0936 \u0915\u0930\u0947\u0902 \u091c\u094b \u0906\u092a\u0915\u094b \u0915\u093f\u0938\u0940 \u090f\u0915 \u0938\u093e\u0902\u091a\u0947 \u092e\u0947\u0902 \u0928 \u092c\u093e\u0902\u0927\u0947\u0902\u0964 \u0906\u092a \u0924\u092c \u0938\u092c\u0938\u0947 \u0905\u091a\u094d\u091b\u093e \u092a\u094d\u0930\u0926\u0930\u094d\u0936\u0928 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902 \u091c\u092c \u0906\u092a\u0915\u094b \u0938\u094d\u0935\u0924\u0902\u0924\u094d\u0930 \u0930\u0942\u092a \u0938\u0947 \u0915\u093e\u092e \u0915\u0930\u0928\u0947 \u0915\u0940 \u091b\u0942\u091f \u092e\u093f\u0932\u0924\u0940 \u0939\u0948\u0964",
