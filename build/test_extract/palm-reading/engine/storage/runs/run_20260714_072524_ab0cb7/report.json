                                        "summary": "\u0906\u092a \u091c\u0940\u0935\u0928 \u0915\u094b \u090f\u0915 \u0924\u0940\u0935\u094d\u0930, \u091c\u0940\u0935\u0902\u0924 \u090a\u0930\u094d\u091c\u093e \u0915\u0947 \u0938\u093e\u0925 \u091c\u0940\u0924\u0947 \u0939\u0948\u0902 \u091c\u094b \u0938\u094d\u0935\u093e\u092d\u093e\u0935\u093f\u0915 \u0930\u0942\u092a \u0938\u0947 \u0926\u0942\u0938\u0930\u094b\u0902 \u0915\u094b \u0906\u0915\u0930\u094d\u0937\u093f\u0924 \u0915\u0930\u0924\u0940 \u0939\u0948\u0964",
                                        "details": "\u090f\u0915 \u0905\u091a\u094d\u091b\u0940 \u0924\u0930\u0939 \u0938\u0947 \u0935\u093f\u0915\u0938\u093f\u0924 \u0936\u0941\u0915\u094d\u0930 \u092a\u0930\u094d\u0935\u0924 (\u0905\u0902\u0917\u0942\u0920\u0947 \u0915\u0947 \u0906\u0927\u093e\u0930 \u092a\u0930) \u0938\u0941\u0902\u0926\u0930\u0924\u093e, \u0906\u0930\u093e\u092e \u0914\u0930 \u091c\u0940\u0935\u0928 \u0915\u0947 \u0938\u0941\u0916\u094b\u0902 \u0915\u0947 \u0932\u093f\u090f \u0917\u0939\u0930\u0940 \u092a\u094d\u0930\u0936\u0902\u0938\u093e \u0915\u094b \u0926\u0930\u094d\u0936\u093e\u0924\u093e \u0939\u0948\u0964 \u0906\u092a \u0915\u094b\u0908 \u092d\u0940 \u0915\u093e\u092e \u0906\u0927\u0947-\u0905\u0927\u0942\u0930\u0947 \u092e\u0928 \u0938\u0947 \u0928\u0939\u0940\u0902 \u0915\u0930\u0924\u0947; \u091c\u092c \u0906\u092a \u092a\u094d\u092f\u093e\u0930 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902, \u0924\u094b \u0917\u0939\u0930\u093e\u0908 \u0938\u0947 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902, \u0914\u0930 \u091c\u092c \u0906\u092a \u0915\u093f\u0938\u0940 \u092a\u0930\u093f\u092f\u094b\u091c\u0928\u093e \u0915\u0947 \u092a\u094d\u0930\u0924\u093f \u091c\u0941\u0928\u0942\u0928\u0940 \u0939\u094b\u0924\u0947 \u0939\u0948\u0902, \u0924\u094b \u0909\u0938\u092e\u0947\u0902 \u0905\u092a\u0928\u0940 \u0906\u0924\u094d\u092e\u093e \u0909\u0902\u0921\u0947\u0932 \u0926\u0947\u0924\u0947 \u0939\u0948\u0902\u0964 \u092f\u0939 \u0917\u0930\u094d\u092e\u091c\u094b\u0936\u0940 \u0914\u0930 \u091a\u0941\u0902\u092c\u0915\u0924\u094d\u0935 \u0906\u092a\u0915\u094b \u090f\u0915 \u0905\u0924\u094d\u092f\u0927\u093f\u0915 \u0906\u0915\u0930\u094d\u0937\u0915 \u0935\u094d\u092f\u0915\u094d\u0924\u093f\u0924\u094d\u0935 \u092c\u0928\u093e\u0924\u0947 \u0939\u0948\u0902\u0964",
