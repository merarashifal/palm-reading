                                "details": "\u090f\u0915 \u0917\u0939\u0930\u0940 \u0939\u0943\u0926\u092f \u0930\u0947\u0916\u093e \u092f\u0939 \u0926\u0930\u094d\u0936\u093e\u0924\u0940 \u0939\u0948 \u0915\u093f \u091c\u092c \u0906\u092a \u092a\u094d\u0930\u0924\u093f\u092c\u0926\u094d\u0927 \u0939\u094b\u0924\u0947 \u0939\u0948\u0902, \u0924\u094b \u092a\u0942\u0930\u0940 \u0924\u0930\u0939 \u0938\u0947 \u0939\u094b\u0924\u0947 \u0939\u0948\u0902\u0964 \u0906\u092a \u092e\u091c\u092c\u0942\u0924 \u0914\u0930 \u0938\u094d\u0925\u093e\u092f\u0940 \u0932\u0917\u093e\u0935 \u092c\u0928\u093e\u0924\u0947 \u0939\u0948\u0902 \u0914\u0930 \u0905\u0915\u094d\u0938\u0930 \u0905\u092a\u0928\u0947 \u091c\u0940\u0935\u0928 \u092e\u0947\u0902 \u0932\u094b\u0917\u094b\u0902 \u0915\u0947 \u0932\u093f\u090f \u090f\u0915 \u092d\u093e\u0935\u0928\u093e\u0924\u094d\u092e\u0915 \u0938\u0939\u093e\u0930\u093e \u092c\u0928\u0924\u0947 \u0939\u0948\u0902\u0964 \u092f\u0926\u094d\u092f\u092a\u093f \u0906\u092a \u0926\u0942\u0938\u0930\u094b\u0902 \u0915\u0940 \u0924\u0941\u0932\u0928\u093e \u092e\u0947\u0902 \u091a\u0940\u091c\u094b\u0902 \u0915\u094b \u0905\u0927\u093f\u0915 \u0924\u0940\u0935\u094d\u0930\u0924\u093e \u0938\u0947 \u092e\u0939\u0938\u0942\u0938 \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902, \u092f\u0939 \u0938\u0902\u0935\u0947\u0926\u0928\u0936\u0940\u0932\u0924\u093e \u0938\u091a\u094d\u091a\u0947 \u0938\u0902\u092c\u0902\u0927 \u092c\u0928\u093e\u0928\u0947 \u092e\u0947\u0902 \u0906\u092a\u0915\u0940 \u0938\u092c\u0938\u0947 \u092c\u0921\u093c\u0940 \u0938\u0902\u092a\u0924\u094d\u0924\u093f \u0939\u0948\u0964",
                                "advice": "\u0905\u092a\u0928\u0947 \u092d\u093e\u0935\u0928\u093e\u0924\u094d\u092e\u0915 \u092d\u0902\u0921\u093e\u0930 \u0915\u0940 \u0930\u0915\u094d\u0937\u093e \u0915\u0930\u0947\u0902\u0964 \u0915\u094d\u092f\u094b\u0902\u0915\u093f \u0906\u092a \u092c\u0939\u0941\u0924 \u0915\u0941\u091b \u0926\u0947\u0924\u0947 \u0939\u0948\u0902, \u0907\u0938\u0932\u093f\u090f \u0906\u092a\u0915\u094b \u0909\u0928 \u0932\u094b\u0917\u094b\u0902 \u0938\u0947 \u0918\u093f\u0930\u0947 \u0930\u0939\u0928\u0947 \u0915\u0947 \u092c\u093e\u0930\u0947 \u092e\u0947\u0902 \u0938\u091a\u0947\u0924 \u0930\u0939\u0928\u093e \u091a\u093e\u0939\u093f\u090f \u091c\u094b \u092c\u0926\u0932\u0947 \u092e\u0947\u0902 \u0909\u0924\u0928\u093e \u0939\u0940 \u092a\u094d\u092f\u093e\u0930 \u0926\u0947\u0924\u0947 \u0939\u0948\u0902\u0964",
